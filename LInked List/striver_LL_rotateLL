
#include <iostream>
using namespace std;

struct ListNode {
    int data;
    ListNode* next;

    ListNode(int x) {
        data = x;
        next = NULL;
    }
};

class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if (head == NULL || head->next == NULL)
            return head;

        int n = 0;
        ListNode* temp = head;

        while (temp != NULL) {
            n++;
            temp = temp->next;
        }

        k = k % n;

        for (int i = 0; i < k; i++) {
            ListNode* p = NULL;
            ListNode* q = head;
            ListNode* r = head->next;

            while (r != NULL) {
                p = q;
                q = r;
                r = r->next;
            }

            p->next = NULL;
            q->next = head;
            head = q;
        }

        return head;
    }
};

int main() {
    ListNode* head = new ListNode(1);
    head->next = new ListNode(2);
    head->next->next = new ListNode(3);
    head->next->next->next = new ListNode(4);
    head->next->next->next->next = new ListNode(5);

    Solution sol;
    head = sol.rotateRight(head, 2);

    ListNode* temp = head;
    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
    return 0;
}
